# Copy to .env and fill in. NEVER commit real secrets.

# Server
PORT=8787
# Comma-separated list of allowed web origins (the game's origin).
CORS_ORIGIN=http://localhost:8000
# Long random string. Generate with: openssl rand -hex 32
# If unset in development, an ephemeral secret is generated (tokens die on restart).
JWT_SECRET=
# Where the JSON data store is written (dev only; use a real DB in production).
DATA_DIR=./data

# --- Stripe (web payments) ---
# From the Stripe dashboard. Use a test key (sk_test_...) for development.
STRIPE_SECRET_KEY=
# From `stripe listen` or the dashboard webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects after success/cancel.
CHECKOUT_SUCCESS_URL=http://localhost:8000/index.html?purchase=success
CHECKOUT_CANCEL_URL=http://localhost:8000/index.html?purchase=cancel

# --- Google Play Billing (Android) ---
# Base64 of a service-account JSON with androidpublisher access, or a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=com.candyblast.app

# --- Apple In-App Purchase (iOS) ---
# App Store Connect shared secret for receipt verification.
APPLE_SHARED_SECRET=
